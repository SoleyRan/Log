@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(Boost REQUIRED COMPONENTS system log_setup log thread filesystem)
find_dependency(Threads REQUIRED)
find_dependency(OpenSSL REQUIRED)
find_dependency(ZLIB REQUIRED)

include("${CMAKE_CURRENT_LIST_DIR}/GoodLogTargets.cmake")

check_required_components(GoodLog)
